    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="http://www.semanticweb.org/v0cn037/ontologies/2026/2/eamm#Application_Driver">
        <rdfs:comment>Class to define and manage the internal and external influences that motivate the Application Objectives.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/v0cn037/ontologies/2026/2/eamm#Business_Capability">
        <rdfs:comment>Models the capabilities of a business or enterprise.
Capabilities belong to business domains and represent the services that a business offers or requires or Business Process &quot;areas&quot;</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/v0cn037/ontologies/2026/2/eamm#Business_Domain">
        <rdfs:comment>Business Domain meta class from the Conceptual view of the Business Architecture.
This is the top level (and least specific) construct in the Business Architecture.
It provides a means of categorizing business related elements independent of the context in which it is applied.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/v0cn037/ontologies/2026/2/eamm#Business_Driver">
        <rdfs:comment>Class to manage business drivers (internal and external influences) which motivate the organization to its business objectives.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/v0cn037/ontologies/2026/2/eamm#Business_Objective">
        <rdfs:comment>A strategic business goal for an enterprise.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/v0cn037/ontologies/2026/2/eamm#Business_Principle">
        <rdfs:comment>High level rules that govern the manner in which business capabilities are delivered by the enterprise</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/v0cn037/ontologies/2026/2/eamm#Skill_Type">
        <rdfs:comment>Conceptual class that is used to provide a taxonomy and semantic grounding for business skill instances.
Instances of Skill_Type should be readily understood without any specialist knowledge.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#Thing">
        <rdfs:label>EAMM</rdfs:label>
    </rdf:Description>
    


