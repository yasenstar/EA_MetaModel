            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Domain"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Driver"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Objective_Type"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Conceptual"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Logical"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Phisical"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Family"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Function"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Provider_Role"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Provider_Type"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Application_Service"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Logical_Application_Model"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/2/eamm#Logical_Software_Architecture"/>
